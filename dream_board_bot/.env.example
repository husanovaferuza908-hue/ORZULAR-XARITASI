# Orzular Xaritasi AI Bot - Muhit o'zgaruvchilari
# Ushbu fayldan nusxa ko'chirib, nomini '.env' ga o'zgartiring va o'z kalitlaringizni kiriting

# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Kaliti (https://platform.openai.com dan olinadi)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API sozlamalari (Ixtiyoriy)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_TEXT=gpt-4o-mini
OPENAI_MODEL_IMAGE=dall-e-3

# Tasvir formati: '1792x1024' (landshaft/16:9), '1024x1024' (kvadrat), '1024x1792' (vertikal)
DEFAULT_IMAGE_SIZE=1792x1024

# Tasvir sifati: 'standard' yoki 'hd'
DEFAULT_IMAGE_QUALITY=standard

# Ma'lumotlar bazasi fayli
DATABASE_PATH=dream_board.db

# Log darajasi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
